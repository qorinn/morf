---
import "../styles/global.css";
import { defaultLocale, localeMetadata, type Locale } from "@/lib/locale";

interface Props {
  title?: string;
  description?: string;
  content?: { title?: string };
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
  robots?: string;
  locale?: Locale;
  alternateLocales?: Array<{ locale: Locale; path: string }>;
}

const {
  content,
  title: titleProp,
  description = "Morf - helyi, célalapú képfeldolgozás a böngészőben.",
  canonicalPath = Astro.url.pathname,
  structuredData,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  locale = defaultLocale,
  alternateLocales = [],
} = Astro.props;
const localeMeta = localeMetadata[locale];
const title = titleProp ?? content?.title ?? "Morf";
const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : canonicalPath;
const localizedStructuredData = structuredData
  ? { ...structuredData, inLanguage: structuredData.inLanguage ?? localeMeta.htmlLang }
  : undefined;
const structuredDataJson = localizedStructuredData
  ? JSON.stringify(localizedStructuredData).replaceAll("<", "\\u003c")
  : undefined;
const ogImageUrl = Astro.site
  ? new URL("/og-image.webp", Astro.site).href
  : "/og-image.webp";
const ogImageAltByLocale: Partial<Record<Locale, string>> = {
  hu: "Morf — ingyenes eszköztár. Nem mentjük el a fájlodat. Soha.",
  en: "Morf — free online tools. We never save your file.",
};
const ogImageAlt = ogImageAltByLocale[locale] ?? ogImageAltByLocale[defaultLocale]!;
---

<html lang={localeMeta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLocales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeMetadata[alternate.locale].htmlLang}
          href={Astro.site ? new URL(alternate.path, Astro.site).href : alternate.path}
        />
      ))
    }
    {
      alternateLocales.find((alternate) => alternate.locale === defaultLocale) && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={Astro.site
            ? new URL(
                alternateLocales.find((alternate) => alternate.locale === defaultLocale)!.path,
                Astro.site,
              ).href
            : alternateLocales.find((alternate) => alternate.locale === defaultLocale)!.path}
        />
      )
    }
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Paládi Bálint" />
    <meta name="application-name" content="Morf" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMeta.ogLocale} />
    <meta property="og:site_name" content="Morf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      Astro.site && (
        <meta
          property="og:url"
          content={new URL(canonicalPath, Astro.site).href}
        />
      )
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      structuredDataJson && (
        <script
          is:inline
          type="application/ld+json"
          set:html={structuredDataJson}
        />
      )
    }
  </head>
  <body class="relative isolate min-h-screen overflow-x-clip antialiased">
    <slot />
  </body>
</html>
