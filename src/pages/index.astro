---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import MainLayout from "@/layouts/main.astro";
import {
  ArrowRight02Icon,
  BrowserIcon,
  Image02Icon,
} from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import HomeHeroGravity from "../components/home/HomeHeroGravity"

const tools = [
  {
    title: "Képkonvertáló",
    description:
      "Alakíts át több JPG, PNG vagy WebP képet egyszerre, és állítsd be a méretet és a minőséget egy helyen.",
    href: "/kep-konvertalo",
    cta: "Képek konvertálása",
    icon: Image02Icon,
    formats: "JPG, PNG, WebP",
    features: [
      "Formátumváltás és átméretezés",
      "Több kép feldolgozása egyszerre",
      "Mentés egyenként vagy ZIP-ben",
    ],
  },
  {
    title: "Favicon generátor",
    description:
      "Készíts egyetlen képből weboldalhoz és telepíthető webapphoz használható ikoncsomagot.",
    href: "/favicon-generator",
    cta: "Favicon készítése",
    icon: BrowserIcon,
    formats: "ICO, PNG, Apple, PWA",
    features: [
      "Vágás és előnézet valódi ikonméretben",
      "Maskable ikonokhoz külön biztonsági zóna",
      "Válaszd ki, mire van szükséged: weboldalhoz vagy webapphoz",
    ],
  },
];
---

<MainLayout
  title="Morf - Online eszközök egy helyen"
  description="Folyamatosan bővülő böngészős eszköztár konvertáláshoz, generáláshoz és más gyakori digitális feladatokhoz."
>
  <SiteHeader
    active="home"
    actionHref="#eszkozok"
    actionLabel="Eszközök megnyitása"
    actionShortLabel="Eszközök"
  />

  <main>
    <HomeHeroGravity client:load />

    <section
      id="eszkozok"
      aria-labelledby="eszkozok-title"
      class="mx-auto flex w-full max-w-5xl scroll-mt-6 flex-col gap-8 px-4 py-16 sm:px-6 lg:px-8 lg:py-20"
    >
      <header class="flex max-w-2xl flex-col gap-3">
        <h2
          id="eszkozok-title"
          class="font-heading text-3xl font-medium tracking-tight sm:text-4xl"
        >
          Válassz egy eszközt
        </h2>
        <p class="text-muted-foreground leading-relaxed">
          Ezek az eszközök már használhatók. A Morf később további
          konvertálókkal, generátorokkal és online segédletekkel bővül.
        </p>
      </header>

      <div class="grid gap-5 md:grid-cols-2">
        {
          tools.map((tool) => (
            <Card>
              <CardHeader>
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span
                    class="bg-secondary text-secondary-foreground inline-flex size-12 items-center justify-center rounded-3xl"
                    aria-hidden="true"
                  >
                    <HugeiconsIcon
                      icon={tool.icon}
                      strokeWidth={1.8}
                      className="size-6"
                    />
                  </span>
                  <p class="text-muted-foreground text-xs font-medium">
                    {tool.formats}
                  </p>
                </div>
                <CardTitle>
                  <h3>{tool.title}</h3>
                </CardTitle>
                <CardDescription>{tool.description}</CardDescription>
              </CardHeader>
              <CardContent>
                <ul class="text-muted-foreground flex flex-col border-t border-current/15 text-sm">
                  {tool.features.map((feature) => (
                    <li class="border-b border-current/15 py-2">{feature}</li>
                  ))}
                </ul>
              </CardContent>
              <CardFooter>
                <a
                  href={tool.href}
                  class={buttonVariants({ variant: "outline" })}
                >
                  {tool.cta}
                  <HugeiconsIcon
                    icon={ArrowRight02Icon}
                    strokeWidth={1.8}
                    data-icon="inline-end"
                  />
                </a>
              </CardFooter>
            </Card>
          ))
        }
      </div>
    </section>

    <section class="morf-dark-section">
      <div
        class="mx-auto grid w-full max-w-7xl gap-5 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(16rem,0.7fr)_minmax(0,1fr)] lg:gap-16 lg:px-8 lg:py-20"
      >
        <h2
          class="font-heading text-3xl font-medium tracking-tight text-balance"
        >
          A fájleszközök helyben dolgoznak
        </h2>
        <div class="max-w-2xl">
          <p class="text-dark-section-muted leading-relaxed text-pretty">
            A képkonvertáló és a favicon generátor a feldolgozást a böngésződben
            végzi. Nincs szerveres képfeltöltés, regisztráció vagy napi
            fájllimit.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
