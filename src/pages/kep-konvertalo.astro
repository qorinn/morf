---
import ImageWorkspace from "@/components/workspace/ImageWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import ImageConverterGuide from "@/components/sections/ImageConverterGuide.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";
import { getImageConverterMessages } from "@/i18n/image-converter";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "hu" as const;
const copy = getImageConverterMessages(locale);
const privacyItems = copy.page.privacy.items;

const faqItems = [
  {
    question: "Milyen formátumok között konvertálhatok?",
    answer:
      "JPG, PNG, WebP, AVIF és HEIC/HEIF állóképeket adhatsz hozzá, a kimenet pedig JPG, PNG, WebP vagy AVIF lehet. A Morf a fájl tényleges tartalmát is ellenőrzi, nem csak a kiterjesztését.",
  },
  {
    question: "Konvertálhatok több képet egyszerre, különböző beállításokkal?",
    answer:
      "Igen. Minden konfigurációs csoport saját feltöltési területet és konvertálási beállításokat kap. Csoportonként eltérő felhasználási célt, kimeneti formátumot, maximális felbontást, minőséget, maximum fájlméretet vagy veszteségmentes módot választhatsz, majd egyetlen futtatással elkészítheted az összes bevont képet.",
  },
  {
    question: "Hogyan konvertálhatok egyszerre egy teljes képmappát?",
    answer:
      "Támogatott böngészőben egy teljes mappát és annak almappáit is hozzáadhatod egyetlen csoportként. A Morf sorban halad a képekkel, ezért nagy mappáknál és videóból készült képeknél sem kell mindent egyszerre megnyitnia.",
  },
  {
    question: "Hogyan rendezhetem át a képeket a csoportok között?",
    answer:
      "A kép kártyáját a fogantyúnál megfogva áthúzhatod ugyanazon csoport másik helyére, egy másik csoportba vagy az Új csoport kártyára. Több képet is kijelölhetsz: az alsó műveleti sávból közös meglévő vagy új csoportba helyezheted, külön csoportokra bonthatod, illetve törölheted őket.",
  },
  {
    question: "Hogyan csökkenthetem a képeket egy megadott fájlméret alá?",
    answer:
      "Kapcsold be a maximum fájlméretet, majd add meg a kívánt határt kilobájtban. A Morf megkeresi a lehető legjobb, még a határ alá férő minőséget, és szükség esetén a felbontást is tovább csökkenti. Ha a fájl eleve kisebb, és a formátuma nem változik, érintetlen marad.",
  },
  {
    question: "A 100%-os minőség ugyanaz, mint a veszteségmentes konvertálás?",
    answer:
      "Nem minden formátumnál. A 100%-os minőség veszteséges kódolóknál is jelenthet újrakódolást. A veszteségmentes mód külön beállítás: megtartja az eredeti felbontást, felülírja a minőség- és célméret-beállításokat, JPG-nél pedig a legmagasabb elérhető minőséget használja.",
  },
  {
    question: "Átalakíthatok több HEIC vagy HEIF képet JPG formátumba?",
    answer:
      "Igen. Több iPhone-ról származó HEIC vagy HEIF állóképet is hozzáadhatsz egyszerre, majd JPG, PNG, WebP vagy AVIF kimenetet választhatsz hozzájuk. A HEIC és HEIF jelenleg bemeneti formátum, HEIC-kimenetet az eszköz nem készít.",
  },
  {
    question: "Mi történik az átlátszó háttérrel JPG konvertáláskor?",
    answer:
      "A JPG nem támogatja az átlátszóságot, ezért az átlátszó képpontok hátteret kapnak. Ha meg szeretnéd tartani az átlátszóságot, válassz PNG, WebP vagy AVIF kimenetet.",
  },
  {
    question: "Mekkora képet konvertálhatok?",
    answer:
      "Nincs napi limit vagy fájlszámláló, de a biztonságos fájlméretet az eszközöd memóriája és teljesítménye korlátozza. Mobilon Morf konzervatívabb határt használ.",
  },
  {
    question: "Ingyenes, reklámmentes és korlátlan a képkonvertáló?",
    answer:
      "Igen. Regisztráció és hirdetések nélkül használhatod, nincs napi fájl- vagy letöltési limit. Sok vagy nagy kép esetén a böngésződ memóriája és a készüléked teljesítménye szabja meg, mennyit tudsz egyszerre feldolgozni.",
  },
  {
    question: "Az animált képek megőrzik az animációt?",
    answer:
      "Nem. Az első verzió állóképekhez készült, animációmegőrzést nem ígér.",
  },
];

const seoTitle = "Ingyenes online képkonvertáló: JPG, PNG, WebP | Morf";
const seoDescription =
  "Ingyenes, reklámmentes képkonvertáló JPG, PNG, WebP, AVIF és HEIC képekhez. Nincs regisztráció vagy napi limit, a fájlok a böngésződben maradnak.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "/kep-konvertalo#alkalmazas",
      name: "Morf online képkonvertáló",
      alternateName: "Morf képkonvertáló",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Képkonvertáló, képtömörítő és képátméretező",
      operatingSystem: "Web",
      browserRequirements:
        "JavaScriptet, Web Workert és WebAssemblyt támogató modern böngésző",
      inLanguage: "hu",
      isAccessibleForFree: true,
      dateModified: "2026-08-03",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "HUF",
      },
      featureList: [
        "Több kép kötegelt konvertálása",
        "Csoportonkénti drag-and-drop képfeltöltés",
        "Képek rendezése csoportokon belül és csoportok között",
        "Több kijelölt kép közös áthelyezése vagy törlése",
        "Felhasználási cél szerinti előbeállítások",
        "Csoportonként eltérő konvertálási beállítások",
        "Teljes képmappák opcionális, memóriahatáros importálása",
        "Nagy képcsoportok feldolgozása a normál konvertálóban",
        "JPG, PNG, WebP és AVIF kimenet",
        "HEIC és HEIF képek beolvasása",
        "Aránytartó képátméretezés",
        "Automatikus igazodás maximum fájlmérethez",
        "Veszteségmentes konvertálási mód",
        "Egyenkénti, mappás és ZIP-mentés",
        "Helyi, böngészőben futó képfeldolgozás",
      ],
      fileFormat: [
        "image/jpeg",
        "image/png",
        "image/webp",
        "image/avif",
        "image/heic",
        "image/heif",
      ],
      creator: {
        "@type": "Person",
        name: "Paládi Bálint",
      },
    },
    {
      "@type": "FAQPage",
      "@id": "/kep-konvertalo#gyakori-kerdesek",
      inLanguage: "hu",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    },
  ],
};
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={getLocalizedRoute("imageConverter", locale)}
  alternateLocales={getRouteAlternates("imageConverter")}
  structuredData={structuredData}
>
  <SiteHeader active="converter" category="kepek" locale={locale} route="imageConverter" />

  <main>
    <ToolHero
      locale={locale}
      title={copy.page.hero.title}
      description={copy.page.hero.description}
      primaryAction={{ href: "#workspace", label: copy.page.hero.primaryAction }}
      secondaryAction={{
        href: "#konvertalas-utmutato",
        label: copy.page.hero.secondaryAction,
      }}
    />

    <ImageWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["faviconGenerator", "videoFrames"]} />

    <ImageConverterGuide />

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={privacyItems}
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={faqItems}
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
