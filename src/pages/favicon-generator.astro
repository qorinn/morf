---
import FaviconWorkspace from "@/components/favicon/FaviconWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaviconPackageGuide from "@/components/sections/FaviconPackageGuide.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";

const privacyItems = [
  "Ha SVG-t töltesz fel, a Morf biztonságosan megtisztítja, mielőtt használja.",
  "Nincs regisztráció, reklám vagy napi letöltési limit.",
];

const faqItems = [
  {
    question: "Milyen képből lesz jó favicon?",
    answer:
      "Egyszerű, négyzetes, erős kontrasztú grafikát használj. Az 1024 × 1024 px-es forrás ideális; 512 px alatt Morf figyelmeztet, mert a nagy PWA-ikon lágyabb lehet.",
  },
  {
    question: "Az SVG megmarad vektorosnak?",
    answer:
      "Igen, ha SVG-t töltesz fel, a csomag a biztonságosan megtisztított SVG-t is tartalmazza. Raszteres képből Morf nem készít ál-vektoros fájlt.",
  },
  {
    question: "Mi van a favicon.ico fájlban?",
    answer:
      "Egy szabványos ICO-konténer, benne külön 16 × 16, 32 × 32 és 48 × 48 pixeles PNG frame-ekkel.",
  },
  {
    question: "Miért különbözik a maskable ikon?",
    answer:
      "Az Android többféle alakra maszkolhatja az appikont. A külön, nagyobb safe-zone-nal és teljes háttérrel készített változat segít elkerülni a fontos részek levágását.",
  },
  {
    question: "Ingyenes és korlátlan a favicon generátor?",
    answer:
      "Igen. A Morf favicon generátora ingyenes, reklámmentes és regisztráció nélkül használható. Nincs napi generálási vagy letöltési limit; a gyakorlati határt csak a saját böngésződ és eszközöd teljesítménye jelenti.",
  },
];
---

<MainLayout
  title="Ingyenes favicon generátor online | Morf"
  description="Készíts favicon.ico, PNG, Apple Touch és PWA ikoncsomagot ingyen, reklámmentesen, regisztráció nélkül. A képed nem kerül szerverre."
  canonicalPath="/favicon-generator"
>
  <SiteHeader active="favicon" category="web" />

  <main>
    <ToolHero
      title="Favicon- és PWA-ikongenerátor"
      description="Készíts favicon.ico-t, Apple Touch ikont és PWA-ikonokat weboldalhoz vagy alkalmazáshoz. PNG- és SVG-logóból is összeállíthatod a böngészők és telefonok számára szükséges ikoncsomagot."
      primaryAction={{
        href: "#favicon-workspace",
        label: "Favicon készítése",
      }}
      secondaryAction={{
        href: "#favicon-csomag-tajekoztato",
        label: "Hogyan működik?",
      }}
    />

    <FaviconWorkspace client:load />

    <RelatedTools hrefs={["/kep-konvertalo", "/megosztasi-elozet-tervezo"]} />

    <FaviconPackageGuide />

    <PrivacySection
      title="Adatvédelem favicon készítésnél"
      description="A faviconcsomag a böngésződben készül el; a forrásképet nem töltjük fel."
      items={privacyItems}
    />

    <FaqSection
      title="Gyakori kérdések"
      description="A forrásképről, az ICO-ról, az SVG-ről és a PWA maskable ikonokról."
      items={faqItems}
    />
  </main>

  <SiteFooter />
</MainLayout>
