---
import VideoSpeedWorkspace from "@/components/video-speed/VideoSpeedWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";

const privacyItems = [
  "A videó, a hangsáv és a sebességgörbe feldolgozása a saját böngésződben fut.",
  "A Morf nem tölti fel a videódat szerverre, és nem tárolja a kész MP4-et.",
  "A hosszabb export a böngésző teljesítményét és a rendelkezésre álló memóriát használja.",
];

const faqItems = [
  {
    question: "Milyen videókat tölthetek fel?",
    answer:
      "MP4, MOV és WebM konténereket. A dekódolhatóság a videó kodekjétől és a böngésződ WebCodecs-támogatásától is függ; az eszköz ezt export előtt ellenőrzi.",
  },
  {
    question: "Mit csinál a sebességgörbe?",
    answer:
      "A vízszintes tengely a forrásvideó elejétől a végéig tart, a függőleges a lejátszási sebességet mutatja. Új ponttal megadhatod, hol lassuljon vagy gyorsuljon fel a videó.",
  },
  {
    question: "Megmarad a hang?",
    answer:
      "Igen, a hangsáv ugyanazt a sebességgörbét kapja, ezért a videóval együtt marad. A Hangmagasság megtartása kapcsoló alapból ki van kapcsolva; bekapcsolva 8×-os sebességig a hang magasságát is megőrzi.",
  },
  {
    question: "Milyen formátum készül?",
    answer:
      "A letöltés H.264/AAC MP4. A forrás felbontása, képaránya és képkockasebessége marad a kiindulópont, de a Morf nem hoz létre mesterséges köztes képkockákat.",
  },
  {
    question: "Miért nem indul el az export?",
    answer:
      "A böngésződnek dekódolnia kell a forrás kodekjét, és H.264-et és AAC-t is kell kódolnia. Ha ez nem elérhető, próbáld friss Chrome-mal vagy Edge-dzsel, illetve H.264-es MP4 forrással.",
  },
];

const seoDescription =
  "Gyorsíts vagy lassíts MP4, MOV és WebM videót pontokból szerkeszthető sebességgörbével, teljesen helyben a böngésződben.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "/video-gyorsitas-lassitas#alkalmazas",
      name: "Morf videó gyorsítás és lassítás",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Videósebesség-szerkesztő",
      operatingSystem: "Web",
      browserRequirements: "JavaScriptet, Web Workert, WebCodecsot és modern audiofeldolgozást támogató böngésző",
      inLanguage: "hu",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "HUF" },
      featureList: [
        "Pontokból szerkeszthető sebességgörbe",
        "Öt előre beállított sebességgörbe",
        "Lejátszható előnézet és kimeneti hosszbecslés",
        "Opcionális hangmagasság-megtartás",
        "Helyi H.264/AAC MP4-export",
      ],
      fileFormat: ["video/mp4", "video/quicktime", "video/webm"],
      creator: { "@type": "Person", name: "Paládi Bálint" },
    },
    {
      "@type": "FAQPage",
      "@id": "/video-gyorsitas-lassitas#gyakori-kerdesek",
      inLanguage: "hu",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title="Videó gyorsítás és lassítás görbével | Morf"
  description={seoDescription}
  canonicalPath="/video-gyorsitas-lassitas"
  structuredData={structuredData}
>
  <SiteHeader
    active="videoSpeed"
    actionHref="#video-speed-workspace"
    actionLabel="Szerkesztő megnyitása"
    actionShortLabel="Megnyitás"
  />

  <main>
    <ToolHero
      title="Videó gyorsítás és lassítás görbével"
      description="Rajzold meg, hol legyen gyorsabb vagy lassabb a videó. Nézd meg előnézetben, majd töltsd le H.264/AAC MP4-ként — a videó közben nálad marad."
      primaryAction={{ href: "#video-speed-workspace", label: "Videó szerkesztése" }}
      secondaryAction={{ href: "#hogyan-mukodik", label: "Hogyan működik?" }}
    />

    <VideoSpeedWorkspace client:load />

    <section id="hogyan-mukodik" class="morf-section-normal scroll-mt-6">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
        <header class="flex max-w-2xl flex-col gap-3">
          <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Így készül el</h2>
          <p class="text-muted-foreground text-base leading-relaxed">Három rövid lépésben állíthatod be a teljes videó tempóját.</p>
        </header>
        <ol class="grid gap-4 md:grid-cols-3">
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">01</span><h3 class="font-heading text-xl font-semibold">Töltsd fel a videót</h3><p class="text-muted-foreground text-sm leading-relaxed">Az eszköz rögtön ellenőrzi a fájlt és a böngésződ kodektámogatását.</p></li>
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">02</span><h3 class="font-heading text-xl font-semibold">Alakítsd a görbét</h3><p class="text-muted-foreground text-sm leading-relaxed">Válassz presetet vagy adj saját pontokat a gyors és lassú részekhez.</p></li>
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">03</span><h3 class="font-heading text-xl font-semibold">Nézd meg és töltsd le</h3><p class="text-muted-foreground text-sm leading-relaxed">A preview után teljes felbontású MP4-et kapsz, helyben elkészítve.</p></li>
        </ol>
      </div>
    </section>

    <PrivacySection
      title="A videód nálad marad"
      description="A Morf a videót, a hangsávot és a kész MP4-et is a saját böngésződben dolgozza fel. Nincs feltöltés vagy szerveroldali renderelés."
      items={privacyItems}
    />

    <FaqSection
      title="Videósebesség-szerkesztés, röviden"
      description="A görbéről, a hangról, az MP4-kimenetről és a böngészős támogatásról."
      items={faqItems}
    />
  </main>

  <SiteFooter />
</MainLayout>
