---
import VideoSpeedWorkspace from "@/components/video-speed/VideoSpeedWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";
import { getVideoSpeedMessages } from "@/i18n/video-speed";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "hu" as const;
const copy = getVideoSpeedMessages(locale);
const canonicalPath = getLocalizedRoute("videoSpeed", locale);

const seoDescription = "Készíts lassítást, gyorsítást vagy egyedi tempóváltást MP4, MOV vagy WebM videóhoz — sportkiemeléshez, social videóhoz vagy time-lapse-hoz. Ingyenes, reklámmentes, regisztráció nélkül.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalPath}#alkalmazas`,
      name: "Morf videó gyorsítás és lassítás",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Videósebesség-szerkesztő",
      operatingSystem: "Web",
      browserRequirements: "JavaScriptet, Web Workert, WebCodecsot és modern audiofeldolgozást támogató böngésző",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "HUF" },
      featureList: [
        "Pontokból szerkeszthető sebességgörbe",
        "Öt előre beállított sebességgörbe",
        "Lejátszható előnézet és kimeneti hosszbecslés",
        "Opcionális hangmagasság-megtartás",
        "Helyi H.264/AAC MP4-export",
      ],
      fileFormat: ["video/mp4", "video/quicktime", "video/webm"],
      creator: { "@type": "Person", name: "Paládi Bálint" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalPath}#gyakori-kerdesek`,
      mainEntity: copy.page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title="Ingyenes videó gyorsító és lassító online | Morf"
  description={seoDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("videoSpeed")}
  structuredData={structuredData}
>
  <SiteHeader active="videoSpeed" category="video" locale={locale} route="videoSpeed" />

  <main>
    <ToolHero
      locale={locale}
      title={copy.page.hero.title}
      description={copy.page.hero.description}
      primaryAction={{ href: "#video-speed-workspace", label: copy.page.hero.primaryAction }}
      secondaryAction={{ href: "#hogyan-mukodik", label: copy.page.hero.secondaryAction }}
    />

    <VideoSpeedWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["videoConverter", "videoFrames"]} locale={locale} />

    <section id="hogyan-mukodik" class="morf-section-normal scroll-mt-6">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-14 px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
        <div class="flex flex-col gap-8">
          <header class="flex max-w-2xl flex-col gap-3">
            <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{copy.guide.title}</h2>
            <p class="text-muted-foreground text-base leading-relaxed">{copy.guide.description}</p>
          </header>
          <ol class="grid gap-4 md:grid-cols-3">
            {copy.guide.steps.map((step, index) => (
              <li class="border-border flex flex-col gap-3 border-t pt-4">
                <span class="text-primary text-sm font-semibold tabular-nums">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="font-heading text-xl font-semibold">{step.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>

        <section aria-labelledby="video-speed-use-cases-title" class="border-border grid gap-10 border-t pt-12 sm:pt-16 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1fr)] lg:gap-20">
          <header class="max-w-xl">
            <h3 id="video-speed-use-cases-title" class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{copy.guide.useCasesTitle}</h3>
          </header>
          <div class="grid gap-x-8 sm:grid-cols-2">
            {copy.guide.useCases.map((useCase) => (
              <article class="border-border border-t py-5">
                <h4 class="font-medium">{useCase.title}</h4>
                <p class="text-muted-foreground mt-2 leading-relaxed">{useCase.description}</p>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={copy.page.privacy.items}
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={[...copy.page.faq.items]}
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
