---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import { buttonVariants } from "@/components/ui/button";
import MainLayout from "@/layouts/main.astro";
import { ArrowRight02Icon, Home01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
---

<MainLayout
  title="Az oldal nem található - Morf"
  description="A keresett Morf-oldal nem található."
  canonicalPath="/404"
  robots="noindex, nofollow"
>
  <SiteHeader active={null} />

  <main
    class="morf-section-normal flex min-h-[calc(100dvh-13rem)] items-center"
  >
    <section
      aria-labelledby="not-found-title"
      class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 sm:py-24 lg:px-8"
    >
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <p
          class="text-primary font-heading text-7xl leading-none font-semibold tracking-[-0.06em] sm:text-8xl"
          aria-hidden="true"
        >
          404
        </p>
        <h1
          id="not-found-title"
          class="font-heading mt-6 text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl"
        >
          Ez az oldal nincs itt
        </h1>
        <p
          class="text-muted-foreground mt-5 max-w-xl text-base leading-relaxed text-pretty sm:text-lg"
        >
          Lehet, hogy a cím megváltozott, vagy a keresett oldal már nem érhető
          el. A főoldalon megtalálod az összes használható eszközt.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/" class={buttonVariants({ size: "lg" })}>
            <HugeiconsIcon
              icon={Home01Icon}
              strokeWidth={1.8}
              className="size-4"
              aria-hidden="true"
            />
            Vissza a főoldalra
          </a>
          <a
            href="/#eszkozok"
            class={buttonVariants({ variant: "outline", size: "lg" })}
          >
            Eszközök megnyitása
            <HugeiconsIcon
              icon={ArrowRight02Icon}
              strokeWidth={1.8}
              className="size-4"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</MainLayout>
