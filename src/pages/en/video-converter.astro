---
import VideoConverterWorkspace from "@/components/video-converter/VideoConverterWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";
import { getVideoConverterMessages } from "@/i18n/video-converter";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "en" as const;
const copy = getVideoConverterMessages(locale);
const canonicalPath = getLocalizedRoute("videoConverter", locale);

const seoTitle = "Free Video Converter: MP4, MOV, WebM & More | Morf";
const seoDescription = "Convert MP4, MOV, WebM, MKV, or TS video to another format, and shrink the file size for email, a website, or sharing. Free, ad-free, no sign-up.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalPath}#application`,
      name: "Morf video converter and optimizer",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Video converter",
      operatingSystem: "Web",
      browserRequirements: "A browser with support for JavaScript, Web Workers, and WebCodecs",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: ["MP4, WebM, and MOV output", "Percentage-based resolution reduction", "Estimated file size preview", "Local, in-browser processing"],
      fileFormat: ["video/mp4", "video/quicktime", "video/webm", "video/x-matroska", "video/mp2t"],
      creator: { "@type": "Person", name: "Paládi Bálint" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalPath}#faq`,
      mainEntity: copy.page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("videoConverter")}
  structuredData={structuredData}
>
  <SiteHeader active="videoConverter" category="video" locale={locale} route="videoConverter" />

  <main>
    <ToolHero
      locale={locale}
      title={copy.page.hero.title}
      description={copy.page.hero.description}
      primaryAction={{ href: "#video-converter-workspace", label: copy.page.hero.primaryAction }}
      secondaryAction={{ href: "#hogyan-mukodik", label: copy.page.hero.secondaryAction }}
    />

    <VideoConverterWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["videoSpeed", "videoFrames"]} locale={locale} />

    <section id="hogyan-mukodik" class="morf-section-normal scroll-mt-6">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-14 px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
        <div class="flex flex-col gap-8">
          <header class="flex max-w-2xl flex-col gap-3">
            <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{copy.guide.title}</h2>
            <p class="text-muted-foreground text-base leading-relaxed">{copy.guide.description}</p>
          </header>
          <ol class="grid gap-4 md:grid-cols-3">
            {copy.guide.steps.map((step, index) => (
              <li class="border-border flex flex-col gap-3 border-t pt-4">
                <span class="text-primary text-sm font-semibold tabular-nums">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="font-heading text-xl font-semibold">{step.title}</h3>
                <p class="text-muted-foreground text-sm leading-relaxed">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>

        <section aria-labelledby="video-converter-use-cases-title" class="border-border grid gap-10 border-t pt-12 sm:pt-16 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1fr)] lg:gap-20">
          <header class="max-w-xl">
            <h3 id="video-converter-use-cases-title" class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{copy.guide.useCasesTitle}</h3>
          </header>
          <div class="grid gap-x-8 sm:grid-cols-2">
            {copy.guide.useCases.map((useCase) => (
              <article class="border-border border-t py-5">
                <h4 class="font-medium">{useCase.title}</h4>
                <p class="text-muted-foreground mt-2 leading-relaxed">{useCase.description}</p>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={copy.page.privacy.items}
      eyebrow="Privacy"
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={[...copy.page.faq.items]}
      id="faq"
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
