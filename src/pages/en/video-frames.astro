---
import VideoFrameWorkspace from "@/components/video-frames/VideoFrameWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import VideoFramesGuide from "@/components/sections/VideoFramesGuide.astro";
import MainLayout from "@/layouts/main.astro";
import { getVideoFramesMessages } from "@/i18n/video-frames";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "en" as const;
const copy = getVideoFramesMessages(locale);
const canonicalPath = getLocalizedRoute("videoFrames", locale);

const seoTitle = "Extract Video Frames Online, Free PNG Export | Morf";
const seoDescription = "Extract full-resolution PNG frames from an MP4, MOV, or WebM video — for a thumbnail, a meme, a paused scene, or a frame sequence for a bug report. Free, ad-free, no sign-up.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalPath}#application`,
      name: "Morf video frame extractor",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Video frame exporter",
      operatingSystem: "Web",
      browserRequirements:
        "A modern browser with support for JavaScript, Web Workers, WebCodecs, OffscreenCanvas, and OPFS",
      isAccessibleForFree: true,
      dateModified: "2026-08-05",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      featureList: [
        "Local processing of MP4, MOV, and WebM videos",
        "Every original frame, a selectable FPS, or only the first and last frame",
        "Selectable start and end point",
        "Full-resolution lossless PNGs",
        "Checkpointed, memory-bounded processing",
        "Direct handoff of frames to Morf's image converter",
        "Save to a folder or as ZIP parts",
      ],
      fileFormat: ["video/mp4", "video/quicktime", "video/webm", "image/png"],
      creator: { "@type": "Person", name: "Paládi Bálint" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalPath}#faq`,
      mainEntity: copy.page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("videoFrames")}
  structuredData={structuredData}
>
  <SiteHeader active="videoFrames" category="video" locale={locale} route="videoFrames" />

  <main>
    <ToolHero
      locale={locale}
      title={copy.page.hero.title}
      description={copy.page.hero.description}
      primaryAction={{
        href: "#video-frame-workspace",
        label: copy.page.hero.primaryAction,
      }}
      secondaryAction={{
        href: "#framek-utmutato",
        label: copy.page.hero.secondaryAction,
      }}
    />

    <VideoFrameWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["imageConverter", "videoSpeed"]} locale={locale} />

    <VideoFramesGuide locale={locale} />

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={copy.page.privacy.items}
      eyebrow="Privacy"
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={[...copy.page.faq.items]}
      id="faq"
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
