---
import FaviconWorkspace from "@/components/favicon/FaviconWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaviconPackageGuide from "@/components/sections/FaviconPackageGuide.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";
import { getFaviconMessages } from "@/i18n/favicon";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "en" as const;
const copy = getFaviconMessages(locale);
const canonicalPath = getLocalizedRoute("faviconGenerator", locale);

const seoTitle = "Free Favicon Generator: favicon.ico, PWA & App Icons | Morf";
const seoDescription = "Turn a logo or image into a complete favicon and PWA icon pack — favicon.ico, Apple Touch icon, and Android maskable icons for a new website, web app, or rebrand. Free, no sign-up required.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalPath}#application`,
      name: "Morf favicon generator",
      description: seoDescription,
      applicationCategory: "DesignApplication",
      operatingSystem: "Web",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalPath}#faq`,
      mainEntity: copy.page.faq.items.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("faviconGenerator")}
  structuredData={structuredData}
>
  <SiteHeader active="favicon" category="web" locale={locale} route="faviconGenerator" />

  <main>
    <ToolHero
      locale={locale}
      title={copy.page.hero.title}
      description={copy.page.hero.description}
      primaryAction={{
        href: "#favicon-workspace",
        label: copy.page.hero.primaryAction,
      }}
      secondaryAction={{
        href: `#${copy.guide.sectionId}`,
        label: copy.page.hero.secondaryAction,
      }}
    />

    <FaviconWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["imageConverter", "sharePreview"]} locale={locale} />

    <FaviconPackageGuide locale={locale} />

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={copy.page.privacy.items}
      eyebrow="Privacy"
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={[...copy.page.faq.items]}
      id="faq"
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
