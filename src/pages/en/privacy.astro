---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import MainLayout from "@/layouts/main.astro";
import { getMessages } from "@/i18n/types";
import { privacyMessages } from "@/i18n/privacy";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";
import { interpolateText } from "@/lib/utils";

const locale = "en" as const;
const copy = getMessages(privacyMessages, locale);
const canonicalPath = getLocalizedRoute("privacy", locale);
---

<MainLayout
  title="Privacy notice - Morf"
  description="Morf's privacy notice covering local file processing, technical data, and your rights."
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("privacy")}
>
  <SiteHeader active="privacy" locale={locale} route="privacy" />

  <main>
    <article class="morf-section-normal">
      <header
        class="mx-auto w-full max-w-5xl px-4 pt-20 pb-14 sm:px-6 sm:pt-24 sm:pb-16 lg:px-8 lg:pt-28"
      >
        <p class="text-primary text-sm font-medium">{copy.eyebrow}</p>
        <h1
          class="morf-page-heading font-heading mt-3 max-w-4xl font-semibold tracking-[-0.04em] text-balance sm:text-[3.25rem] lg:text-6xl"
        >
          {copy.title}
        </h1>
        <p
          class="text-muted-foreground mt-6 max-w-3xl text-lg leading-relaxed text-pretty sm:text-xl"
        >
          {copy.lead}
        </p>
        <p class="text-muted-foreground mt-5 text-sm">
          {copy.updatedAtLabel} {copy.updatedAt}
        </p>
      </header>

      <div
        class="mx-auto w-full max-w-5xl px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8 lg:pb-28"
      >
        <div
          class="border-border bg-muted/45 mb-14 rounded-2xl border px-5 py-5 sm:px-6"
        >
          <p class="max-w-3xl text-base leading-relaxed sm:text-lg">
            <strong class="font-semibold">{copy.summaryStrong}</strong>{" "}
            {copy.summaryText}
          </p>
        </div>

        <div class="divide-border divide-y border-y">
          {
            copy.sections.map((section) => (
              <section class="grid gap-5 py-10 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-12">
                <h2 class="font-heading text-2xl font-semibold tracking-tight">
                  {section.title}
                </h2>
                <div class="text-muted-foreground space-y-4 leading-relaxed">
                  {section.paragraphs.map((paragraph) => (
                    <p>
                      {interpolateText(paragraph, {
                        operator: (
                          <strong class="text-foreground font-medium">
                            {copy.operatorName}
                          </strong>
                        ),
                        emailLink: (
                          <a
                            class="text-foreground font-medium underline underline-offset-4"
                            href="mailto:hello@paladi-web.hu"
                          >
                            {copy.emailLinkText}
                          </a>
                        ),
                        naihLink: (
                          <a
                            class="text-foreground font-medium underline underline-offset-4"
                            href="https://www.naih.hu/"
                            rel="noreferrer"
                            target="_blank"
                          >
                            {copy.naihLinkText}
                          </a>
                        ),
                      })}
                    </p>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </article>
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
