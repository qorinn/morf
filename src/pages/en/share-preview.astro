---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import { SharePreviewWorkspace } from "@/components/share-preview/SharePreviewWorkspace";
import MainLayout from "@/layouts/main.astro";
import { getSharePreviewMessages } from "@/i18n/share-preview";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";

const locale = "en" as const;
const copy = getSharePreviewMessages(locale);
const canonicalPath = getLocalizedRoute("sharePreview", locale);

const seoDescription = "Check how your link looks on Facebook, LinkedIn, X, or WhatsApp, and design a custom share image for a blog post, product, or campaign. Free, ad-free, no sign-up.";
---

<MainLayout
  title={copy.page.seoTitle}
  description={seoDescription}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("sharePreview")}
>
  <SiteHeader active="sharePreview" category="web" locale={locale} route="sharePreview" />

  <main>
    <SharePreviewWorkspace client:load locale={locale} />

    <RelatedTools routeIds={["faviconGenerator", "imageConverter"]} locale={locale} />

    <section aria-labelledby="share-preview-use-cases-title" class="morf-section-normal">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-10 border-t px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <header class="max-w-2xl">
          <h2 id="share-preview-use-cases-title" class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{copy.guide.useCasesTitle}</h2>
        </header>
        <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {copy.guide.useCases.map((useCase) => (
            <article class="border-border border-t pt-5">
              <h3 class="font-medium">{useCase.title}</h3>
              <p class="text-muted-foreground mt-2 leading-relaxed">{useCase.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <PrivacySection
      title={copy.page.privacy.title}
      description={copy.page.privacy.description}
      items={copy.page.privacy.items}
      eyebrow="Privacy"
    />

    <FaqSection
      title={copy.page.faq.title}
      description={copy.page.faq.description}
      items={[...copy.page.faq.items]}
      id="faq"
    />
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
