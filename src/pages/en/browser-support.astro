---
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import MainLayout from "@/layouts/main.astro";
import { getMessages } from "@/i18n/types";
import { browserSupportMessages } from "@/i18n/browser-support";
import { getLocalizedRoute, getRouteAlternates } from "@/lib/localized-routes";
import { Cancel01Icon, CheckmarkCircle02Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

const locale = "en" as const;
const copy = getMessages(browserSupportMessages, locale);
const canonicalPath = getLocalizedRoute("browserSupport", locale);

const browserColumns = [
  { key: "chrome", label: "Chrome" },
  { key: "edge", label: "Edge" },
  { key: "firefox", label: "Firefox" },
  { key: "safari", label: "Safari" },
] as const;
---

<MainLayout
  title="Browser support | Morf"
  description="Check which Morf tool works in Chrome, Edge, Firefox, and Safari."
  locale={locale}
  canonicalPath={canonicalPath}
  alternateLocales={getRouteAlternates("browserSupport")}
>
  <SiteHeader active={null} locale={locale} route="browserSupport" />

  <main>
    <section class="morf-section-normal">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
        <header class="flex max-w-3xl flex-col gap-4">
          <p class="text-primary text-sm font-semibold tracking-wide uppercase">{copy.eyebrow}</p>
          <h1 class="font-heading text-4xl font-semibold tracking-tight sm:text-5xl">{copy.title}</h1>
          <p class="text-muted-foreground text-base leading-relaxed sm:text-lg">{copy.lead}</p>
        </header>

        <section class="border-border bg-muted/45 max-w-3xl rounded-3xl border p-5 sm:p-6" aria-labelledby="recommended-browser">
          <h2 id="recommended-browser" class="font-heading text-xl font-semibold">{copy.recommendedTitle}</h2>
          <p class="text-muted-foreground mt-2 leading-relaxed">{copy.recommendedText}</p>
        </section>

        <section aria-labelledby="support-table" class="overflow-hidden rounded-3xl border border-border">
          <div class="border-border border-b px-5 py-5 sm:px-6">
            <h2 id="support-table" class="font-heading text-2xl font-semibold">{copy.tableTitle}</h2>
            <p class="text-muted-foreground mt-1 text-sm leading-relaxed">{copy.tableDescription}</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[45rem] text-left text-sm">
              <thead class="bg-muted/55 text-muted-foreground">
                <tr>
                  <th scope="col" class="px-5 py-4 font-medium sm:px-6">{copy.toolColumnLabel}</th>
                  {browserColumns.map((browser) => <th scope="col" class="px-4 py-4 text-center font-medium">{browser.label}</th>)}
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {copy.tools.map((tool) => (
                  <tr>
                    <th scope="row" class="px-5 py-4 font-medium sm:px-6">
                      <span class="block text-foreground">{tool.name}</span>
                      <span class="text-muted-foreground mt-1 block font-normal leading-relaxed">{tool.description}</span>
                    </th>
                    {browserColumns.map((browser) => (
                      <td class="px-4 py-4 text-center">
                        {tool[browser.key] ? (
                          <span class="inline-flex size-8 items-center justify-center rounded-full bg-primary/12 text-primary" aria-label={`${browser.label}: ${copy.supportedLabel}`} title={copy.supportedLabel}>
                            <HugeiconsIcon icon={CheckmarkCircle02Icon} className="size-5" strokeWidth={2.2} aria-hidden="true" />
                          </span>
                        ) : (
                          <span class="inline-flex size-8 items-center justify-center rounded-full bg-destructive/10 text-destructive" aria-label={`${browser.label}: ${copy.unsupportedLabel}`} title={copy.unsupportedLabel}>
                            <HugeiconsIcon icon={Cancel01Icon} className="size-5" strokeWidth={2.2} aria-hidden="true" />
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <p class="text-muted-foreground max-w-3xl text-sm leading-relaxed">{copy.footnote}</p>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</MainLayout>
