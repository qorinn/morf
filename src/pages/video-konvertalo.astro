---
import VideoConverterWorkspace from "@/components/video-converter/VideoConverterWorkspace";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import PrivacySection from "@/components/sections/PrivacySection.astro";
import RelatedTools from "@/components/sections/RelatedTools.astro";
import ToolHero from "@/components/sections/ToolHero.astro";
import MainLayout from "@/layouts/main.astro";

const privacyItems = [
  "A hosszabb videóknál az export a böngésződ memóriáját és processzorát használja.",
  "Nincs regisztráció, hirdetés vagy napi konvertálási limit.",
];

const faqItems = [
  {
    question: "Milyen videókat tölthetek fel?",
    answer: "MP4, M4V, MOV, WebM, MKV és MPEG-TS videót. A tényleges dekódolhatóság a fájl kodekjétől és a böngésződ WebCodecs-támogatásától is függ.",
  },
  {
    question: "Milyen formátumot tölthetek le?",
    answer: "MP4-et és MOV-ot H.264/AAC kodekkel, WebM-et VP9/Opus kodekkel. Az eszköz feltöltés után megmutatja, melyik kimenet kódolható a böngésződben.",
  },
  {
    question: "Mit jelent a felbontás százalék?",
    answer: "A szélességet és magasságot együtt arányosan csökkenti. A 50% például egy 1920 × 1080-as videóból 960 × 540-es kimenetet készít.",
  },
  {
    question: "Pontosan akkora lesz a kész fájl, mint a becslés?",
    answer: "Nem feltétlenül. A becslés a felbontásból, képkockasebességből, kiválasztott formátumból, minőségből és hangsávból készül. A végső méretet a videó tartalma is befolyásolja.",
  },
  {
    question: "Megmarad a hangsáv?",
    answer: "Igen, ha a böngésződ a forrás hangját dekódolni és a választott kimenet hangkodekjét kódolni tudja. Hang nélküli videónál a kimenet is néma marad.",
  },
  {
    question: "Ingyenes, reklámmentes és korlátlan a videó konvertálása?",
    answer:
      "Igen. A Morf videó konvertálója ingyenes, nem kér fiókot, és nincs napi feltöltési vagy letöltési limit. A kezelhető videóméretet és az export idejét a saját eszközöd teljesítménye és a böngésződ támogatása befolyásolja.",
  },
];

const seoDescription = "Ingyenes online videó konvertáló és optimalizáló MP4, MOV, WebM, MKV és TS fájlokhoz. Reklámmentes, regisztráció nélküli használat napi limit nélkül, helyi feldolgozással.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "/video-konvertalo#alkalmazas",
      name: "Morf videó konvertáló és optimalizáló",
      description: seoDescription,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Videókonvertáló",
      operatingSystem: "Web",
      browserRequirements: "JavaScriptet, Web Workert és WebCodecsot támogató modern böngésző",
      inLanguage: "hu",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "HUF" },
      featureList: ["MP4, WebM és MOV kimenet", "Százalékos felbontáscsökkentés", "Várható fájlméret becslése", "Helyi böngészős feldolgozás"],
      fileFormat: ["video/mp4", "video/quicktime", "video/webm", "video/x-matroska", "video/mp2t"],
      creator: { "@type": "Person", name: "Paládi Bálint" },
    },
    {
      "@type": "FAQPage",
      "@id": "/video-konvertalo#gyakori-kerdesek",
      inLanguage: "hu",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<MainLayout
  title="Ingyenes videó konvertáló és optimalizáló | Morf"
  description={seoDescription}
  canonicalPath="/video-konvertalo"
  structuredData={structuredData}
>
  <SiteHeader active="videoConverter" category="video" />

  <main>
    <ToolHero
      title="Videóformátum-konvertáló és optimalizáló"
      description="Alakíts át MP4, MOV, WebM, MKV és TS videókat, csökkentsd a felbontást és a fájlméretet. Megosztáshoz, weboldalra, e-mailhez vagy telefonon helyfelszabadításhoz."
      primaryAction={{ href: "#video-converter-workspace", label: "Videó konvertálása" }}
      secondaryAction={{ href: "#hogyan-mukodik", label: "Hogyan működik?" }}
    />

    <VideoConverterWorkspace client:load />

    <RelatedTools hrefs={["/video-gyorsitas-lassitas", "/video-kepekre-bontasa"]} />

    <section id="hogyan-mukodik" class="morf-section-normal scroll-mt-6">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
        <header class="flex max-w-2xl flex-col gap-3">
          <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Három lépésben kész</h2>
          <p class="text-muted-foreground text-base leading-relaxed">A formátumváltás és az optimalizálás egyetlen helyi feldolgozásban fut le.</p>
        </header>
        <ol class="grid gap-4 md:grid-cols-3">
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">01</span><h3 class="font-heading text-xl font-semibold">Töltsd fel a videót</h3><p class="text-muted-foreground text-sm leading-relaxed">Az eszköz ellenőrzi a konténert, a kodeket és a rendelkezésre álló kimeneteket.</p></li>
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">02</span><h3 class="font-heading text-xl font-semibold">Állítsd be a kimenetet</h3><p class="text-muted-foreground text-sm leading-relaxed">Válassz formátumot, felbontást és minőségi szintet, majd ellenőrizd a becsült méretet.</p></li>
          <li class="border-border flex flex-col gap-3 border-t pt-4"><span class="text-primary text-sm font-semibold tabular-nums">03</span><h3 class="font-heading text-xl font-semibold">Töltsd le</h3><p class="text-muted-foreground text-sm leading-relaxed">A Morf a kész videót a böngésződben állítja elő, majd rögtön letöltheted.</p></li>
        </ol>
      </div>
    </section>

    <PrivacySection
      title="Adatvédelem videókonvertáláskor"
      description="A videó átméretezése és formátumváltása a böngésződben fut; a Morf nem küldi a fájlt szerverre."
      items={privacyItems}
    />

    <FaqSection
      title="Videókonvertálás, röviden"
      description="A támogatott formátumokról, felbontásról, fájlméretről és a hangsávról."
      items={faqItems}
    />
  </main>

  <SiteFooter />
</MainLayout>
