---
import { buttonVariants } from "@/components/ui/button";

interface Action {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  primaryAction: Action;
  secondaryAction?: Action;
}

const { title, description, primaryAction, secondaryAction } = Astro.props;
---

<section class="morf-section-normal">
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-start gap-6 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
  >
    <div class="flex flex-col gap-4">
      <h1
        class="font-heading max-w-4xl text-5xl font-medium tracking-tight text-balance sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <p
        class="text-muted-foreground max-w-2xl text-lg leading-relaxed sm:text-xl"
      >
        {description}
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={primaryAction.href} class={buttonVariants({ size: "lg" })}>
        {primaryAction.label}
      </a>
      {
        secondaryAction && (
          <a
            href={secondaryAction.href}
            class={buttonVariants({ variant: "ghost", size: "lg" })}
          >
            {secondaryAction.label}
          </a>
        )
      }
    </div>
  </div>
</section>
