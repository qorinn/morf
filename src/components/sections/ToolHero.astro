---
import { buttonVariants } from "@/components/ui/button";
import { CheckmarkCircle02Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { commonMessages } from "@/i18n/common";
import { getMessages } from "@/i18n/types";
import type { Locale } from "@/lib/locale";

interface Action {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  primaryAction: Action;
  secondaryAction?: Action;
  locale?: Locale;
}

const { title, description, primaryAction, secondaryAction, locale = "hu" } = Astro.props;
const copy = getMessages(commonMessages, locale);
const benefits = copy.benefits;
---

<section class="morf-section-normal">
  <div
    class="mx-auto flex min-h-[32rem] w-full max-w-7xl flex-col items-center justify-center gap-8 px-4 py-20 text-center sm:min-h-[36rem] sm:px-6 sm:py-24 lg:px-8 lg:py-28"
  >
    <div class="flex max-w-5xl flex-col items-center gap-5">
      <h1
        class="morf-page-heading font-heading leading-[0.94] font-semibold tracking-[-0.05em] text-balance sm:text-[clamp(3.25rem,7vw,5.75rem)]"
      >
        {title}
      </h1>
      <p
        class="text-muted-foreground max-w-2xl text-base leading-relaxed text-pretty sm:text-xl"
      >
        {description}
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={primaryAction.href} class={buttonVariants({ size: "lg" })}>
        {primaryAction.label}
      </a>
      {
        secondaryAction && (
          <a
            href={secondaryAction.href}
            class={buttonVariants({ variant: "ghost", size: "lg" })}
          >
            {secondaryAction.label}
          </a>
        )
      }
    </div>
    <ul class="text-muted-foreground flex max-w-3xl flex-wrap justify-center gap-x-4 gap-y-2 text-sm" aria-label={copy.toolHero.benefitsLabel}>
      {benefits.map((benefit) => (
        <li class="flex items-center gap-1.5 whitespace-nowrap">
          <HugeiconsIcon icon={CheckmarkCircle02Icon} className="size-4 text-primary" strokeWidth={2} aria-hidden="true" />
          {benefit}
        </li>
      ))}
    </ul>
  </div>
</section>
