---
import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title: string;
  description?: string;
  id?: string;
}

const { items, title, description, id = "gyakori-kerdesek" } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={titleId} class="morf-section-normal">
  <div
    class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(16rem,0.62fr)_minmax(0,1fr)] lg:gap-16 lg:px-8"
  >
    <header
      class="flex max-w-xl flex-col items-start gap-4 lg:sticky lg:top-10 lg:self-start"
    >
      <h2
        id={titleId}
        class="font-heading text-3xl font-medium tracking-tight text-balance sm:text-4xl"
      >
        {title}
      </h2>
      {
        description && (
          <p class="text-muted-foreground max-w-md leading-relaxed">
            {description}
          </p>
        )
      }
    </header>

    <div class="border-border border-b">
      {
        items.map((item) => (
          <details class="group border-border border-t">
            <summary class="hover:bg-muted/60 focus-visible:ring-ring/30 flex min-h-16 cursor-pointer list-none items-center gap-4 px-1 py-4 font-medium transition-colors duration-200 select-none focus-visible:ring-3 focus-visible:outline-none sm:px-2 [&::-webkit-details-marker]:hidden">
              <span class="flex-1 text-left">{item.question}</span>
              <HugeiconsIcon
                icon={ArrowDown01Icon}
                strokeWidth={2}
                className="text-muted-foreground size-5 shrink-0 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
                aria-hidden="true"
              />
            </summary>
            <div class="text-muted-foreground pr-12 pb-5 pl-1 leading-relaxed sm:pr-14 sm:pl-2">
              <p class="max-w-2xl text-pretty">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
