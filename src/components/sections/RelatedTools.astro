---
import { ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import { getTools } from "@/data/tool-catalog";
import { commonMessages } from "@/i18n/common";
import { getMessages } from "@/i18n/types";
import type { Locale } from "@/lib/locale";
import { getLocalizedRoute, type LocalizedRouteId } from "@/lib/localized-routes";

interface Props {
  hrefs?: string[];
  routeIds?: LocalizedRouteId[];
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  hrefs = [],
  routeIds,
  locale = "hu",
} = Astro.props;
const copy = getMessages(commonMessages, locale);
const title = Astro.props.title ?? copy.relatedTools.title;
const description = Astro.props.description ?? copy.relatedTools.description;
const tools = getTools(locale);
const relatedHrefs = routeIds?.map((route) => getLocalizedRoute(route, locale)) ?? hrefs;
const relatedTools = relatedHrefs
  .map((href) => tools.find((tool) => tool.href === href))
  .filter((tool): tool is (typeof tools)[number] => Boolean(tool));
---

{relatedTools.length > 0 && (
  <section class="morf-section-normal" aria-labelledby="kapcsolodo-eszkozok-cim">
    <div class="mx-auto flex w-full max-w-7xl flex-col gap-7 px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
      <header class="flex max-w-2xl flex-col gap-2">
        <h2 id="kapcsolodo-eszkozok-cim" class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
        <p class="text-muted-foreground text-base leading-relaxed">{description}</p>
      </header>

      <div class="grid gap-3 md:grid-cols-2">
        {relatedTools.map((tool) => (
          <a href={tool.href} class="group border-border bg-card hover:border-primary/45 hover:bg-muted/40 focus-visible:ring-ring flex min-h-34 items-start gap-4 rounded-2xl border p-5 outline-none transition-colors duration-200 focus-visible:ring-3">
            <span class="bg-primary/10 text-primary flex size-10 shrink-0 items-center justify-center rounded-xl">
              <HugeiconsIcon icon={tool.icon} className="size-5" strokeWidth={1.8} aria-hidden="true" />
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-1.5">
              <span class="text-foreground flex items-center gap-2 font-semibold">
                {tool.title}
                <HugeiconsIcon icon={ArrowRight01Icon} className="size-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none" strokeWidth={2} aria-hidden="true" />
              </span>
              <span class="text-muted-foreground text-sm leading-relaxed">{tool.shortDescription}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
