---
import { ShieldKeyIcon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

interface Props {
  items: string[];
  title: string;
  eyebrow?: string;
  description?: string;
  id?: string;
}

const {
  items,
  title,
  eyebrow = "Privacy by design",
  description,
  id = "adatvedelem",
} = Astro.props;
const titleId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={titleId}
  class="morf-dark-section relative isolate overflow-hidden"
>
  <HugeiconsIcon
    icon={ShieldKeyIcon}
    strokeWidth={0.7}
    className="text-dark-section-accent pointer-events-none absolute top-1/2 -right-32 size-96 -translate-y-1/2 rotate-[-7deg] opacity-[0.06] sm:-right-20 sm:size-[30rem] lg:right-[2%] lg:size-[36rem]"
    aria-hidden="true"
  />

  <div
    class="relative mx-auto grid w-full max-w-7xl gap-12 px-4 py-20 sm:px-6 sm:py-24 lg:grid-cols-[minmax(20rem,0.86fr)_minmax(0,1fr)] lg:gap-20 lg:px-8 lg:py-28"
  >
    <header class="max-w-2xl">
      <p class="text-dark-section-accent text-sm font-medium">{eyebrow}</p>
      <h2
        id={titleId}
        class="text-dark-section-heading font-heading mt-3 text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
      >
        {title}
      </h2>
      {
        description && (
          <p class="text-dark-section-muted mt-5 max-w-xl text-base leading-relaxed text-pretty sm:text-lg">
            {description}
          </p>
        )
      }
    </header>

    <ul
      class="border-dark-section-border divide-dark-section-border flex flex-col divide-y border-y"
      role="list"
    >
      {
        items.map((item) => (
          <li class="text-dark-section-muted py-5 text-base leading-relaxed sm:py-6 sm:text-lg">
            <span class="block max-w-2xl text-pretty">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
