---
import {
  Film01Icon,
  Image02Icon,
  SlidersHorizontalIcon,
} from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { getVideoFramesMessages } from "@/i18n/video-frames";
import type { Locale } from "@/lib/locale";

interface Props {
  locale?: Locale;
}

const { locale = "hu" } = Astro.props;
const copy = getVideoFramesMessages(locale).guide;
const stepIcons = [Film01Icon, SlidersHorizontalIcon, Image02Icon];
const steps = copy.steps.map((step, index) => ({ ...step, icon: stepIcons[index] }));
---

<section
  id="framek-utmutato"
  aria-labelledby="framek-utmutato-title"
  class="morf-section-normal"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
  >
    <header class="flex max-w-3xl flex-col gap-3">
      <h2
        id="framek-utmutato-title"
        class="font-heading text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
      >
        {copy.title}
      </h2>
    </header>

    <ol class="grid gap-6 lg:grid-cols-3">
      {
        steps.map((step) => (
          <li class="flex min-w-0 flex-col gap-5">
            <div class="flex items-center justify-between gap-4">
              <span class="bg-muted text-foreground flex size-11 items-center justify-center rounded-2xl border">
                <HugeiconsIcon
                  icon={step.icon}
                  className="size-5"
                  strokeWidth={1.8}
                  aria-hidden="true"
                />
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="font-heading text-xl font-medium">{step.title}</h3>
              <p class="text-muted-foreground leading-relaxed">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <section
      aria-labelledby="video-frames-use-cases-title"
      class="border-border grid gap-10 border-t pt-12 sm:pt-16 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1fr)] lg:gap-20"
    >
      <header class="max-w-xl">
        <h3
          id="video-frames-use-cases-title"
          class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
        >
          {copy.useCasesTitle}
        </h3>
      </header>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {
          copy.useCases.map((useCase) => (
            <article class="border-border border-t py-5">
              <h4 class="font-medium">{useCase.title}</h4>
              <p class="text-muted-foreground mt-2 leading-relaxed">
                {useCase.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
