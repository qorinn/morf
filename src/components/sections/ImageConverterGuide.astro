---
import { getImageConverterMessages } from "@/i18n/image-converter";
import type { Locale } from "@/lib/locale";

interface Props {
  locale?: Locale;
}

const { locale = "hu" } = Astro.props;
const copy = getImageConverterMessages(locale).guide;
---

<section
  id="kep-konvertalo-funkciok"
  aria-labelledby="kep-konvertalo-funkciok-title"
  class="morf-section-normal scroll-mt-6"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-20 px-4 py-20 sm:px-6 sm:py-24 lg:gap-24 lg:px-8 lg:py-28"
  >
    <header class="flex max-w-4xl flex-col gap-7">
      <div class="max-w-3xl">
        <h2
          id="kep-konvertalo-funkciok-title"
          class="font-heading text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
        >
          {copy.title}
        </h2>
      </div>
      <div
        class="flex max-w-3xl flex-col gap-5 text-base leading-relaxed sm:text-lg"
      >
        <p class="text-pretty">
          <strong class="text-foreground font-medium">{copy.intro.lead}</strong>
        </p>
        <p class="text-muted-foreground text-pretty">
          {copy.intro.body}
        </p>
      </div>
    </header>

    <div class="border-border border-t pt-12 sm:pt-16">
      <div class="max-w-2xl">
        <h3
          class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          {copy.capabilitiesTitle}
        </h3>
      </div>
      <dl class="mt-10 grid gap-x-12 md:grid-cols-2">
        {
          copy.capabilities.map((capability) => (
            <div class="border-border border-t py-7">
              <dt class="font-heading text-lg font-semibold sm:text-xl">
                {capability.title}
              </dt>
              <dd class="text-muted-foreground mt-3 max-w-prose leading-relaxed">
                {capability.description}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <section
      id="konvertalas-utmutato"
      aria-labelledby="csoportos-konvertalas-title"
      class="morf-dark-card border-dark-section-border rounded-3xl border p-7 sm:p-10 lg:p-12 scroll-mt-20 md:scroll-mt-40"
    >
      <div
        class="grid gap-10 lg:grid-cols-[minmax(16rem,0.72fr)_minmax(0,1fr)] lg:gap-16"
      >
        <header class="max-w-xl">
          <h3
            id="csoportos-konvertalas-title"
            class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
          >
            {copy.stepsTitle}
          </h3>
          <p
            class="text-dark-section-muted mt-5 text-base leading-relaxed sm:text-lg"
          >
            {copy.stepsIntro}
          </p>
        </header>
        <ol class="border-dark-section-border flex flex-col border-b">
          {
            copy.steps.map((step, index) => (
              <li class="border-dark-section-border grid grid-cols-[2.5rem_minmax(0,1fr)] gap-3 border-t py-6 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-4">
                <span
                  class="text-dark-section-accent font-heading pt-1 text-sm font-semibold tabular-nums"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h4 class="font-heading text-lg font-semibold sm:text-xl">
                    {step.title}
                  </h4>
                  <p class="text-dark-section-muted mt-2 max-w-2xl leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      aria-labelledby="formatumok-title"
      class="border-border flex flex-col gap-10 border-t pt-12 sm:pt-16"
    >
      <header class="max-w-3xl">
        <h3
          id="formatumok-title"
          class="font-heading text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          {copy.formatsTitle}
        </h3>
        <p
          class="text-muted-foreground mt-5 max-w-2xl text-base leading-relaxed text-pretty sm:text-lg"
        >
          {copy.formatsIntro}
        </p>
      </header>

      <div class="ring-border overflow-x-auto rounded-3xl ring-1">
        <table class="w-full min-w-3xl border-collapse text-left">
          <caption class="sr-only">
            {copy.formatsTitle}
          </caption>
          <thead class="bg-muted/60">
            <tr>
              <th class="px-4 py-3 font-medium sm:px-5">{copy.formatTable.format}</th>
              <th class="px-4 py-3 font-medium sm:px-5">{copy.formatTable.input}</th>
              <th class="px-4 py-3 font-medium sm:px-5">{copy.formatTable.output}</th>
              <th class="px-4 py-3 font-medium sm:px-5">
                {copy.formatTable.useCase}
              </th>
            </tr>
          </thead>
          <tbody class="divide-border divide-y">
            {
              copy.formatRows.map((row) => (
                <tr>
                  <th class="px-4 py-4 font-medium whitespace-nowrap sm:px-5">
                    {row.format}
                  </th>
                  <td class="px-4 py-4 sm:px-5">{row.input}</td>
                  <td class="px-4 py-4 sm:px-5">{row.output}</td>
                  <td class="text-muted-foreground min-w-72 px-4 py-4 leading-relaxed sm:px-5">
                    {row.useCase}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section
      aria-labelledby="felhasznalasi-modok-title"
      class="border-border grid gap-10 border-t pt-12 sm:pt-16 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1fr)] lg:gap-20"
    >
      <header class="max-w-xl">
        <h3
          id="felhasznalasi-modok-title"
          class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
        >
          {copy.useCasesTitle}
        </h3>
      </header>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {
          copy.useCases.map((useCase) => (
            <article class="border-border border-t py-5">
              <h4 class="font-medium">{useCase.title}</h4>
              <p class="text-muted-foreground mt-2 leading-relaxed">
                {useCase.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
