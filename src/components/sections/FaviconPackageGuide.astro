---
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { getFaviconMessages } from "@/i18n/favicon";
import type { Locale } from "@/lib/locale";
import { interpolateText } from "@/lib/utils";

interface Props {
  locale?: Locale;
}

const { locale = "hu" } = Astro.props;
const copy = getFaviconMessages(locale).guide;
---

<section
  id={copy.sectionId}
  aria-labelledby="favicon-package-guide-title"
  class="morf-section-normal scroll-mt-8"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-16 px-4 py-20 sm:px-6 sm:py-24 lg:gap-20 lg:px-8 lg:py-28"
  >
    <header class="flex max-w-4xl flex-col items-start gap-5">
      <h2
        id="favicon-package-guide-title"
        class="font-heading text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
      >
        {copy.title}
      </h2>
      <p
        class="text-muted-foreground max-w-3xl text-base leading-relaxed text-pretty sm:text-lg"
      >
        {copy.intro}
      </p>
    </header>

    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-stretch"
    >
      <Card
        className="morf-dark-card border-dark-section-border rounded-3xl text-dark-section-foreground"
      >
        <CardHeader>
          <CardTitle className="text-dark-section-heading">
            <h3 class="font-heading text-2xl font-semibold tracking-tight">
              {copy.website.title}
            </h3>
          </CardTitle>
          <CardDescription
            className="text-dark-section-muted text-base leading-relaxed sm:text-lg"
          >
            {copy.website.description}
          </CardDescription>
        </CardHeader>
        <CardContent>
          <p class="font-medium">{copy.website.body}</p>
        </CardContent>
      </Card>

      <div class="border-border flex flex-col border-y">
        <article class="py-7">
          <h3
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            {copy.webApp.title}
          </h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            {copy.webApp.body}
          </p>
        </article>
        <article class="border-border border-t py-7">
          <h3
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            {copy.manifestAddon.title}
          </h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            {copy.manifestAddon.body}
          </p>
        </article>
      </div>
    </div>

    <div
      class="border-border grid gap-12 border-t pt-12 sm:pt-16 lg:grid-cols-3 lg:gap-10"
    >
      <article aria-labelledby="website-favicon-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="website-favicon-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              {copy.websiteFilesTitle}
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              {copy.websiteFilesDescription}
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            copy.websiteFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="flex flex-wrap items-center gap-2 font-medium">
                    <code class="text-sm">{file.name}</code>
                    {file.optional && (
                      <Badge variant="outline">{copy.optionalBadge}</Badge>
                    )}
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>

      <article aria-labelledby="webapp-icon-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="webapp-icon-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              {copy.webAppFilesTitle}
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              {copy.webAppFilesDescription}
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            copy.webAppFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="font-medium">
                    <code class="text-sm">{file.name}</code>
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>

      <article aria-labelledby="manifest-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="manifest-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              {copy.manifestFilesTitle}
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              {copy.manifestFilesDescription}
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            copy.manifestFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="font-medium">
                    <code class="text-sm">{file.name}</code>
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>
    </div>

    <p
      class="morf-inset-panel text-muted-foreground rounded-3xl p-4 text-sm leading-relaxed"
    >
      {interpolateText(copy.readmeNoteTemplate, { file: <code>README.md</code> })}
    </p>

    <section
      aria-labelledby="favicon-use-cases-title"
      class="border-border grid gap-10 border-t pt-12 sm:pt-16 lg:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1fr)] lg:gap-20"
    >
      <header class="max-w-xl">
        <h3
          id="favicon-use-cases-title"
          class="font-heading text-2xl font-semibold tracking-tight text-balance sm:text-3xl"
        >
          {copy.useCasesTitle}
        </h3>
      </header>
      <div class="grid gap-x-8 sm:grid-cols-2">
        {
          copy.useCases.map((useCase) => (
            <article class="border-border border-t py-5">
              <h4 class="font-medium">{useCase.title}</h4>
              <p class="text-muted-foreground mt-2 leading-relaxed">
                {useCase.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
