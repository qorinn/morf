---
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const websiteFiles = [
  {
    name: "favicon.ico",
    description:
      "A hagyományos, széles körben támogatott böngészőikon. Egyetlen fájlban tartalmazza a 16, 32 és 48 pixeles változatot.",
  },
  {
    name: "favicon-16x16.png",
    description:
      "A böngészőfül és a nagyon kis méretű böngészőfelületek éles ikonja.",
  },
  {
    name: "favicon-32x32.png",
    description:
      "Nagy pixelsűrűségű kijelzőkön használt favicon, például böngészőfülekhez és könyvjelzőkhöz.",
  },
  {
    name: "favicon-48x48.png",
    description:
      "Nagyobb böngésző- és rendszerfelületekhez használható PNG favicon.",
  },
  {
    name: "apple-touch-icon.png",
    description:
      "Az iPhone és iPad ezt használja, amikor valaki a weboldalt a kezdőképernyőhöz adja.",
  },
  {
    name: "favicon.svg",
    optional: true,
    description:
      "Modern böngészőkben minden méreten éles, skálázható favicon. Csak akkor kerül a csomagba, ha SVG fájlt töltesz fel.",
  },
  {
    name: "favicon-code.html",
    description:
      "A weboldal <head> részébe másolható, kész HTML hivatkozásokat tartalmazza.",
  },
];

const webAppFiles = [
  {
    name: "web-app-manifest-192x192.png",
    description:
      "A telepített webalkalmazás normál, kisebb felbontású ikonja Androidon és más PWA-képes rendszereken.",
  },
  {
    name: "web-app-manifest-512x512.png",
    description:
      "A telepítéshez és nagyobb rendszerfelületekhez használt nagy felbontású alkalmazásikon.",
  },
  {
    name: "web-app-manifest-192x192-maskable.png",
    description:
      "Biztonsági margóval készülő kis PWA-ikon, amelyet az operációs rendszer kör, négyzet vagy más alakúra vághat.",
  },
  {
    name: "web-app-manifest-512x512-maskable.png",
    description:
      "A maskable alkalmazásikon nagy felbontású változata telepítési és indítófelületekhez.",
  },
];

const manifestFiles = [
  {
    name: "site.webmanifest",
    description:
      "A telepíthető webalkalmazás stabil azonosítóját, indulási URL-jét, navigációs hatókörét, nevét, ikonjait, színeit és megjelenítési módját leíró, használatra kész fájl.",
  },
  {
    name: "favicon-code.html",
    description:
      "A weboldal <head> részébe másolható manifest hivatkozást és theme-color meta elemet tartalmazza. Ha a Weboldal opciót is kéred, annak favicon hivatkozásai ugyanebbe a fájlba kerülnek.",
  },
];
---

<section
  id="favicon-package-guide"
  aria-labelledby="favicon-package-guide-title"
  class="morf-section-normal scroll-mt-8"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col gap-16 px-4 py-20 sm:px-6 sm:py-24 lg:gap-20 lg:px-8 lg:py-28"
  >
    <header class="flex max-w-4xl flex-col items-start gap-5">
      <h2
        id="favicon-package-guide-title"
        class="font-heading text-4xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl"
      >
        Pontosan melyik favicon és webapp fájlokra van szükséged?
      </h2>
      <p
        class="text-muted-foreground max-w-3xl text-base leading-relaxed text-pretty sm:text-lg"
      >
        Az exportcélok szabadon kombinálhatók. Egyszerű weboldalhoz csak a
        Weboldal opció kell; telepíthető webapphoz válaszd a webappikonokat, és
        kérésre a használatra kész site.webmanifest fájlt is.
      </p>
    </header>

    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-stretch"
    >
      <Card
        className="morf-dark-card border-dark-section-border rounded-3xl text-dark-section-foreground"
      >
        <CardHeader>
          <CardTitle className="text-dark-section-heading">
            <h3 class="font-heading text-2xl font-semibold tracking-tight">
              Weboldal
            </h3>
          </CardTitle>
          <CardDescription
            className="text-dark-section-muted text-base leading-relaxed sm:text-lg"
          >
            Bloghoz, céges oldalhoz, webshophoz vagy portfólióhoz. Ettől jelenik
            meg az ikon a böngészőfülön, a könyvjelzőkben és Apple eszközökön.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <p class="font-medium">
            Jelöld be minden hagyományos weboldalhoz, bloghoz, webshophoz és
            portfólióhoz.
          </p>
        </CardContent>
      </Card>

      <div class="border-border flex flex-col border-y">
        <article class="py-7">
          <h3
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            Telepíthető webalkalmazás
          </h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            Normál és maskable ikonokat készít a kezdőképernyőre vagy az
            alkalmazásindítóba telepíthető webapphoz. A weboldalas faviconokat
            külön jelölheted be.
          </p>
        </article>
        <article class="border-border border-t py-7">
          <h3
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            + site.webmanifest
          </h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            A webapp nevét, ikonjait, színeit és indulási beállításait
            összekapcsoló manifestet készít. Az offline működéshez ettől
            függetlenül külön service worker szükséges.
          </p>
        </article>
      </div>
    </div>

    <div
      class="border-border grid gap-12 border-t pt-12 sm:pt-16 lg:grid-cols-3 lg:gap-10"
    >
      <article aria-labelledby="website-favicon-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="website-favicon-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              A Weboldal fájljai
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              Ezek adják a böngészős favicon és az Apple Touch ikon támogatását.
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            websiteFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="flex flex-wrap items-center gap-2 font-medium">
                    <code class="text-sm">{file.name}</code>
                    {file.optional && (
                      <Badge variant="outline">Opcionális</Badge>
                    )}
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>

      <article aria-labelledby="webapp-icon-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="webapp-icon-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              A webapp ikonfájljai
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              Csak a Telepíthető webalkalmazás opció kiválasztásakor készülnek
              el.
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            webAppFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="font-medium">
                    <code class="text-sm">{file.name}</code>
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>

      <article aria-labelledby="manifest-files-title">
        <div class="mb-5">
          <div>
            <h3
              id="manifest-files-title"
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              A manifest kiegészítés
            </h3>
            <p class="text-muted-foreground mt-2 text-base leading-relaxed">
              A + site.webmanifest opció a webapp ikonok mellé a telepítési
              metaadatokat és a HTML-hivatkozást adja.
            </p>
          </div>
        </div>

        <dl class="border-border border-b">
          {
            manifestFiles.map((file) => (
              <div class="border-border border-t py-4">
                <div>
                  <dt class="font-medium">
                    <code class="text-sm">{file.name}</code>
                  </dt>
                  <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
                    {file.description}
                  </dd>
                </div>
              </div>
            ))
          }
        </dl>
      </article>
    </div>

    <p
      class="morf-inset-panel text-muted-foreground rounded-3xl p-4 text-sm leading-relaxed"
    >
      A <code>README.md</code> minden exportba bekerül, és csak a kiválasztott fájlokhoz
      tartozó telepítési lépéseket sorolja fel. Ha a Weboldal és a manifest opció
      is aktív, egy közös <code>favicon-code.html</code> készül.
    </p>
  </div>
</section>
