---
import { commonMessages } from "@/i18n/common";
import { getTools } from "@/data/tool-catalog";
import { getMessages } from "@/i18n/types";
import type { Locale } from "@/lib/locale";
import { getLocalizedRoute } from "@/lib/localized-routes";

interface Props {
  locale?: Locale;
}

const { locale = "hu" } = Astro.props;
const common = getMessages(commonMessages, locale);
const homeHref = getLocalizedRoute("home", locale);
const catalog = getTools(locale);
const imageConverter = catalog.find((tool) => tool.id === "imageConverter");
const faviconGenerator = catalog.find((tool) => tool.id === "faviconGenerator");
---

<footer
  class="text-muted-foreground mx-auto flex w-full max-w-7xl flex-col justify-between gap-5 px-4 py-8 text-sm sm:px-6 lg:flex-row lg:items-center lg:px-8"
>
  <div class="flex flex-col gap-1">
    <p>© {new Date().getFullYear()} Morf</p>
    <p>
      {common.footer.madeBy}{" "}
      <a
        class="hover:text-foreground rounded-sm underline-offset-4 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
        href="https://www.paladi-web.hu/"
        rel="noreferrer"
        target="_blank">Paládi Webfejlesztés</a
      >
    </p>
  </div>

  <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label={common.footer.navLabel}>
    <a class="hover:text-foreground transition-colors" href={homeHref}>{common.navigation.home}</a>
    {imageConverter && <a class="hover:text-foreground transition-colors" href={imageConverter.href}>{imageConverter.title}</a>}
    {faviconGenerator && <a class="hover:text-foreground transition-colors" href={faviconGenerator.href}>{faviconGenerator.title}</a>}
    <a class="hover:text-foreground transition-colors" href={getLocalizedRoute("browserSupport", locale)}
      >{common.navigation.browserSupport}</a
    >
    <a
      class="hover:text-foreground transition-colors"
      href={getLocalizedRoute("privacy", locale)}>{common.navigation.privacy}</a
    >
  </nav>
</footer>
