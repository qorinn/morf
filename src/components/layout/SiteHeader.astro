---
import fullLogo from "@/assets/brand/morf-logo-full.svg";
import minimalLogo from "@/assets/brand/morf-logo-minimal.svg";
import { buttonVariants } from "@/components/ui/button";
import type { Locale } from "@/lib/locale";

interface Props {
  active?:
    | "home"
    | "converter"
    | "favicon"
    | "videoFrames"
    | "videoSpeed"
    | "videoConverter"
    | "sharePreview"
    | "privacy"
    | null;
  category?: "kepek" | "video" | "web";
  locale?: Locale;
  languageHref?: string;
  languageLabel?: string;
}

const {
  active = "home",
  category,
  locale = "hu",
  languageHref,
  languageLabel,
} = Astro.props;

const copy = locale === "en" ? {
  announcementStrong: "Work in progress.",
  announcement: "Morf is still being built and has not been fully tested.",
  allTools: "All tools",
  allToolsMobile: "Tools",
  homeLabel: "Morf home",
} : {
  announcementStrong: "Nem kész verzió.",
  announcement: "A Morf jelenleg még épül, és nincs tesztelve.",
  allTools: "Összes eszköz",
  allToolsMobile: "Eszközök",
  homeLabel: "Morf kezdőlap",
};
const categories = locale === "en" ? {
  kepek: { label: "Image tools", mobileLabel: "Images" },
  video: { label: "Video tools", mobileLabel: "Video" },
  web: { label: "Web tools", mobileLabel: "Web" },
} : {
  kepek: { label: "Képes eszközök", mobileLabel: "Képek" },
  video: { label: "Videós eszközök", mobileLabel: "Videó" },
  web: { label: "Webes eszközök", mobileLabel: "Web" },
} as const;
const currentCategory = category ? categories[category] : undefined;
const homeHref = locale === "en" ? "/en/" : "/";
---

<header id="siteHeader">
  <div class="border-b bg-secondary/60 text-secondary-foreground">
    <p
      class="mx-auto flex h-8 max-h-8 overflow-hidden w-full max-w-7xl items-center justify-center gap-2 px-4 text-center text-xs leading-4 sm:px-6 lg:px-8"
    >
      <span
        class="inline-block size-1.5 shrink-0 rounded-full bg-secondary-foreground"
        aria-hidden="true"></span>
      <span>
        <strong class="font-semibold">{copy.announcementStrong}</strong>
        <span> {copy.announcement}</span>
      </span>
    </p>
  </div>

  <nav
    class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 pt-5 sm:px-6 lg:px-8"
    aria-label="Fő navigáció"
  >
    <a
      href={homeHref}
      class="flex items-center"
      aria-label={copy.homeLabel}
      aria-current={active === "home" ? "page" : undefined}
    >
      <img
        src={minimalLogo.src}
        width={minimalLogo.width}
        height={minimalLogo.height}
        alt=""
        class="size-10 sm:hidden"
      />
      <img
        src={fullLogo.src}
        width={fullLogo.width}
        height={fullLogo.height}
        alt=""
        class="hidden h-10 w-auto sm:block"
      />
    </a>

    <div class="flex items-center justify-end gap-1.5 sm:gap-2">
      <a href={`${homeHref}#eszkozok`} class={buttonVariants({ variant: "ghost", size: "sm" })}>
        <span class="sm:hidden">{copy.allToolsMobile}</span>
        <span class="hidden sm:inline">{copy.allTools}</span>
      </a>
      {
        currentCategory && (
          <a href={`${homeHref}#eszkoz-kategoria-${category}`} class={buttonVariants({ variant: "outline", size: "sm" })}>
            <span class="sm:hidden">{currentCategory.mobileLabel}</span>
            <span class="hidden sm:inline">{currentCategory.label}</span>
          </a>
        )
      }
      {
        languageHref && languageLabel && (
          <a
            href={languageHref}
            class={buttonVariants({ variant: "outline", size: "sm" })}
            aria-label={locale === "en" ? "Switch to Hungarian" : "Váltás angol nyelvre"}
          >
            {languageLabel}
          </a>
        )
      }
    </div>
  </nav>
</header>
